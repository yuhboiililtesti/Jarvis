# JARVIS environment configuration — copy to `.env` and fill in your values.
# Nothing here contains real credentials; every value is a placeholder.

# ---- SSH tunnels (scripts/jarvis-tunnels.py) ----
# Private key + known_hosts used for the tunnel connections.
JARVIS_SSH_KEY=~/.ssh/id_ed25519
JARVIS_SSH_KNOWN_HOSTS=~/.ssh/known_hosts
JARVIS_SSH_USER=your_ssh_user

# Core host (the machine running jarvis-core) and SSH port.
JARVIS_APOS_HOST=core-host.lan
JARVIS_APOS_PORT=2223

# Optional satellite node host and SSH port.
JARVIS_LAPTOP_HOST=node-host.lan
JARVIS_LAPTOP_PORT=2225

# ---- Node agent bind address (scripts/jarvis-node-supervisor.py) ----
JARVIS_NODE_HOST=127.0.0.1
JARVIS_NODE_PORT=2228

# ---- Algorithm toolkit bridge (jarvis/compute/engine.py) ----
JARVIS_ALGOKIT_PATH=/path/to/algorithms-toolkit

# ---- Frontier LLM tier (optional) ----
# Set one or more of these to enable the remote high-capability tier.
JARVIS_SECRET_ANTHROPIC_KEY=sk-ant-...
JARVIS_SECRET_GEMINI_KEY=your_gemini_key
JARVIS_SECRET_GROQ_KEY=gsk_...

# ---- Anton bridge (optional) ----
ANTON_URL=http://<ANTON_HOST>:8787
ANTON_TOKEN=your_anton_token
